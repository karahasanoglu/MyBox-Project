# Küçük ve yaygın bir Python imajı
FROM python:3.12-slim

# Çalışma dizini
WORKDIR /app

# Önce requirements (cache için iyi pratik)
COPY requirements.txt .

# Paket yok ama yine de standart akış:
RUN pip install --no-cache-dir -r requirements.txt

# Uygulama dosyası
COPY app.py .

# Varsayılan komut
CMD ["python", "app.py"]
